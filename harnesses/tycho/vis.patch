+// ---- v4-parity harness additions (visibility only; no logic change) ----
+impl UniswapV4State {
+    /// Calls the private `swap` unchanged. Returns
+    /// (amount_calculated, amount_remaining, sqrt_price, liquidity, tick).
+    pub fn parity_swap(
+        &self,
+        zero_for_one: bool,
+        amount_specified: I256,
+        sqrt_price_limit: Option<U256>,
+        lp_fee_override: Option<u32>,
+    ) -> Result<(I256, I256, U256, u128, i32), SimulationError> {
+        let r = self.swap(zero_for_one, amount_specified, sqrt_price_limit, lp_fee_override)?;
+        Ok((r.amount_calculated, r.amount_remaining, r.sqrt_price, r.liquidity, r.tick))
+    }
+    pub fn parity_fee_pips(&self, zero_for_one: bool, lp_fee_override: Option<u32>) -> u32 {
+        self.fees.calculate_swap_fees_pips(zero_for_one, lp_fee_override)
+    }
+    /// (sqrt_price, liquidity, tick)
+    pub fn parity_state(&self) -> (U256, u128, i32) {
+        (self.sqrt_price, self.liquidity, self.tick)
+    }
+}
